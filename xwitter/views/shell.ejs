<!doctype html><html lang="pt-BR" data-bs-theme="dark"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Xwitter</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/style.css" rel="stylesheet"></head><body><a class="skip" href="#conteudo">Pular para conteúdo</a><header class="topbar"><a href="/" class="brand"><img src="/logo.svg" alt="" width="31" height="31"> xwitter<span class="dot">.</span></a><nav aria-label="Navegação principal"><a href="/feed">Feed</a><a href="/explorar">Explorar</a><% if(me){ %><a href="/atividade">Minha atividade</a><a href="/perfil/<%= me.handle %>">Perfil</a><a href="/configuracoes">Ajustes</a><form method="post" action="/sair" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="navbutton">Sair</button></form><% }else{ %><a href="/login">Entrar</a><% } %><button type="button" class="navbutton" id="theme" aria-label="Alternar tema">◐</button></nav></header><main id="conteudo" class="container-shell"><% if(typeof error!=='undefined' && error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<% if(page==='home'){ %><section class="hero"><div><span class="eyebrow">UM ESPAÇO PARA IDEIAS</span><h1>Suas palavras criam <em>conexões.</em></h1><p>Compartilhe pensamentos, acompanhe pessoas e descubra conversas que valem a pena.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-coral" href="/cadastro">Começar agora ↗</a><a class="btn btn-outline-light" href="/feed">Conhecer a comunidade</a></div></div><img src="/hero.svg" alt="Ilustração abstrata de mensagens conectadas" class="hero-art"></section><section class="features"><div>✧ <strong>Converse</strong><span>Responda a publicações.</span></div><div>♡ <strong>Conecte-se</strong><span>Siga suas pessoas favoritas.</span></div><div>◈ <strong>Explore</strong><span>Descubra novos assuntos.</span></div></section>
<% }else if(page==='login'||page==='register'){ %><div class="auth-bg" id="particles" aria-hidden="true"></div><section class="auth cardish"><span class="eyebrow">BEM-VINDO AO XWITTER</span><h1><%= page==='login'?'Bom ter você de volta.':'Uma conta. Mil conversas.' %></h1><form method="post" action="/<%= page==='login'?'login':'cadastro' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(page==='register'){ %><label for="name">Nome</label><input id="name" name="name" maxlength="80" required autocomplete="name"><label for="handle">Identificador</label><input id="handle" name="handle" pattern="[a-z0-9_]{3,32}" minlength="3" maxlength="32" required placeholder="seu_usuario"><% } %><label for="email">E-mail</label><input id="email" name="email" type="email" required autocomplete="email"><label for="password">Senha <%= page==='register'?'(15 a 128 caracteres)':'' %></label><input id="password" name="password" type="password" required <%= page==='register'?'minlength=15 maxlength=128 autocomplete=new-password':'autocomplete=current-password' %>><button class="btn btn-coral w-100 mt-3"><%= page==='login'?'Entrar':'Criar minha conta' %></button></form><p class="mt-3 muted"><%= page==='login'?'Ainda não tem conta?':'Já tem conta?' %> <a href="/<%= page==='login'?'cadastro':'login' %>"><%= page==='login'?'Cadastre-se':'Entre agora' %></a></p><button id="motion" type="button" class="quiet">Pausar animação</button></section><script src="https://cdn.jsdelivr.net/npm/p5@1.11.5/lib/p5.min.js" defer></script><script src="/login.js" defer></script>
<% }else if(page==='feed'){ %><div class="layout"><aside class="sidebar"><p class="eyebrow">DESCUBRA MAIS</p><h2>Uma conversa<br>de cada vez.</h2><p>As ideias mais novas da comunidade aparecem aqui.</p></aside><div><div class="section-head"><span class="eyebrow">LINHA DO TEMPO</span><h1>Seu feed<span class="dot">.</span></h1><div class="d-flex gap-2"><a class="pill <%=filter==='geral'?'active':''%>" href="/feed">Para todos</a><% if(me){ %><a class="pill <%=filter==='seguindo'?'active':''%>" href="/feed?filtro=seguindo">Seguindo</a><% } %></div></div><% if(me){ %><form method="post" action="/publicar" class="composer cardish"><input type="hidden" name="_csrf" value="<%=csrf%>"><label for="body" class="h5">O que está acontecendo?</label><textarea id="body" name="body" required maxlength="1120" data-max-graphemes="280" placeholder="Conte uma ideia, faça uma pergunta..." rows="3"></textarea><div class="composer-footer"><span class="count">0 / 280</span><button class="btn btn-coral">Publicar ↗</button></div></form><% } %><%- include('posts',{posts}) %><div class="d-flex justify-content-between mt-4"><% if(pageNo>1){ %><a class="pill" href="?page=<%=pageNo-1%>&filtro=<%=filter%>">← Anterior</a><% } %><% if(hasNext){ %><a class="pill" href="?page=<%=pageNo+1%>&filtro=<%=filter%>">Próxima →</a><% } %></div></div></div>
<% }else if(page==='thread'){ %><div class="narrow"><a class="quiet" href="/feed">← Voltar ao feed</a><h1>Conversa<span class="dot">.</span></h1><%- include('posts',{posts}) %><% if(me){ %><form class="cardish composer" action="/publicar" method="post"><input type="hidden" name="_csrf" value="<%=csrf%>"><input type="hidden" name="parentId" value="<%=parent.id%>"><label for="body">Sua resposta</label><textarea id="body" name="body" required data-max-graphemes="280"></textarea><div class="composer-footer"><span class="count">0 / 280</span><button class="btn btn-coral">Responder</button></div></form><% } %></div>
<% }else if(page==='profile'){ %><div class="narrow"><div class="cardish profile-top"><span class="avatar big <%=user.avatar%>">✦</span><div><span class="eyebrow">PERFIL DA COMUNIDADE</span><h1><%=user.name%></h1><p class="muted">@<%=user.handle%></p><p><%=user.bio||'Cada mensagem é um começo.'%></p><p><b><%=followers%></b> seguidores · <b><%=following%></b> seguindo</p><% if(me&&me.id!==user.id){ %><form method="post" action="/perfil/<%=user.id%>/<%=followed?'deixar-de-seguir':'seguir'%>"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="btn btn-coral"><%=followed?'Deixar de seguir':'Seguir +' %></button></form><% } %></div></div><h2>Publicações</h2><%- include('posts',{posts}) %></div>
<% }else if(page==='explore'){ %><div class="narrow"><span class="eyebrow">O MUNDO EM CONVERSA</span><h1>Explorar<span class="dot">.</span></h1><form method="get" class="search"><label for="search">Pesquise pessoas, mensagens e hashtags</label><div class="d-flex gap-2"><input id="search" name="q" maxlength="80" value="<%=q%>" placeholder="#web, design, pessoas..."><button class="btn btn-coral">Buscar</button></div></form><% if(users.length){ %><h2>Pessoas</h2><div class="cardish"><% users.forEach(u=>{ %><p><a href="/perfil/<%=u.handle%>"><strong><%=u.name%></strong> · @<%=u.handle%></a></p><% }) %></div><% } %><h2>Publicações</h2><%- include('posts',{posts}) %></div>
<% }else if(page==='settings'){ %><div class="narrow"><span class="eyebrow">SEU ESPAÇO</span><h1>Configurações<span class="dot">.</span></h1><form method="post" action="/configuracoes" class="cardish settings"><input type="hidden" name="_csrf" value="<%=csrf%>"><label for="name">Nome público</label><input id="name" name="name" required maxlength="80" value="<%=me.name%>"><label for="bio">Biografia</label><textarea id="bio" name="bio" maxlength="240"><%=me.bio%></textarea><label for="avatar">Avatar</label><select id="avatar" name="avatar"><% ['aurora','lago','sol','orbita'].forEach(a=>{ %><option value="<%=a%>" <%=me.avatar===a?'selected':''%>><%=a%></option><% }) %></select><button class="btn btn-coral mt-3">Salvar perfil</button></form></div>
<% }else if(page==='activity'){ %><span class="eyebrow">A SUA JORNADA EM DADOS</span><h1>Minha atividade<span class="dot">.</span></h1><div class="statgrid"><% [['Publicações',stats.posts],['Seguidores',stats.followers],['Seguindo',stats.following],['Curtidas recebidas',stats.likes],['Respostas recebidas',stats.replies]].forEach(x=>{ %><div class="stat"><span><%=x[0]%></span><b><%=x[1]%></b></div><% }) %></div><div class="charts"><section class="cardish"><h2>Últimos 7 dias</h2><p class="muted">Publicações principais por dia (UTC).</p><div class="chart" id="days" data-json="<%=JSON.stringify(stats.days)%>"></div><table class="table"><thead><tr><th>Dia</th><th>Publicações</th></tr></thead><tbody><% stats.days.forEach(x=>{ %><tr><td><%=x.day%></td><td><%=x.value%></td></tr><% })%></tbody></table></section><section class="cardish"><h2>Seus assuntos</h2><p class="muted">Hashtags distintas por publicação.</p><div class="chart" id="tags" data-json="<%=JSON.stringify(stats.tags)%>"></div><table class="table"><thead><tr><th>Hashtag</th><th>Publicações</th></tr></thead><tbody><% stats.tags.forEach(x=>{ %><tr><td>#<%=x.tag%></td><td><%=x.value%></td></tr><% })%></tbody></table></section></div><script defer src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script><script defer src="/charts.js"></script>
<% } %></main><footer>✦ Xwitter · Ideias que aproximam. <span>Projeto acadêmico COLTEC</span></footer><script src="/main.js" defer></script></body></html>

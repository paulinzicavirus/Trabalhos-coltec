<% if(!posts.length){ %><div class="cardish empty">Ainda não há publicações por aqui. ✦</div><% } %><% posts.forEach(p=>{ %><article class="post cardish"><div class="post-head"><span class="avatar <%=p.author.avatar%>">✦</span><div><a class="author" href="/perfil/<%=p.author.handle%>"><%=p.author.name%></a><div class="muted">@<%=p.author.handle%> · <time datetime="<%=new Date(p.createdAt).toISOString()%>"><%=new Date(p.createdAt).toLocaleDateString('pt-BR')%></time></div></div></div><p class="post-text"><%=p.body%></p><div class="post-actions"><a href="/publicacao/<%=p.parentId||p.id%>">↩ Respostas <%=p.replies||''%></a><span aria-label="<%=p.likes%> curtidas">♡ <%=p.likes%></span><% if(me){ %><form method="post" action="/publicacao/<%=p.id%>/<%=p.liked?'descurtir':'curtir'%>"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="quiet" aria-pressed="<%=!!p.liked%>"><%=p.liked?'♥ Curtido':'♡ Curtir'%></button></form><% if(me.id===p.authorId){ %><form method="post" action="/publicacao/<%=p.id%>/excluir"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="quiet danger" aria-label="Excluir publicação">Excluir</button></form><% } %><% } %></div></article><% }) %>
